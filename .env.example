# Require shared access code on login (true by default; set false to skip login prompt).
KIREMDATA_REQUIRE_ACCESS_CODE=true

# Shared LAN/VPN access code. Use at least 12 characters.
# If unset while KIREMDATA_REQUIRE_ACCESS_CODE=true, the hub generates a temporary code on startup.
KIREMDATA_ACCESS_CODE=

# Persistent hub data and received-file staging directory.
# KIREMDATA_DATA_DIR="/path/to/private/kiremdata-data"
# KIREMDATA_SAVE_DIR="/path/to/Downloads/KiremData"

# Set true for a local trusted HTTPS reverse proxy, or specify its trusted IP/CIDR.
# The proxy must support WebSocket upgrades and set X-Forwarded-Proto.
KIREMDATA_TRUST_PROXY=false
